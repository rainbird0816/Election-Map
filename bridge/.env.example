# bridge/.env  — 실제 값으로 채운 뒤 파일명을 .env 로 복사하세요 (절대 커밋 금지)

# BotFather 가 발급한 봇 토큰 (필수)
TELEGRAM_BOT_TOKEN=

# 명령을 허용할 본인 chat ID. 비워두면 "발견 모드"로 동작하여
# 봇에게 아무 메시지나 보내면 chat ID 를 알려줍니다. 여러 명은 콤마로 구분.
TELEGRAM_CHAT_ID=

# Claude Code 가 작업할 디렉터리 (기본: 저장소 루트). 보통 비워두면 됩니다.
# PROJECT_DIR=E:\Korea Election

# 권한 모드: skip(기본) | acceptEdits | default
#  - skip       : --dangerously-skip-permissions (모든 작업 자동 승인, 가장 편하지만 위험)
#  - acceptEdits: 파일 편집만 자동 승인
#  - default    : 자동 승인 없음(헤드리스에서는 대부분의 작업이 거부될 수 있음)
CLAUDE_PERMISSION=skip

# 모델 지정 (선택, 예: claude-opus-4-8)
# CLAUDE_MODEL=

# 단일 작업 최대 실행시간(ms). 기본 30분.
# CLAUDE_TIMEOUT_MS=1800000
